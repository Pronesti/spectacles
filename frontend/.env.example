VITE_API_BASE_URL=http://localhost:8000

# Google Maps: enable Maps JavaScript API and restrict the browser key to your origins.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Optional Yerd dev URL. Also set VITE_API_BASE_URL=https://api.spectacles.test.
# DEV_SERVER_URL=https://spectacles.test

# Optional login prefill: put local account values in ignored .env.local.
# Used only by the development server; excluded from production builds.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
